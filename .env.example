# Copier ce fichier en .env et renseigner les vraies valeurs (jamais commit .env)

# Chaîne de connexion PostgreSQL fournie par Supabase
# (Project Settings > Database > Connection string > URI)
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# Identifiants Supabase Storage
# (Project Settings > API)
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="[SERVICE_ROLE_KEY]"
SUPABASE_STORAGE_BUCKET="documents"

# Secrets JWT (générer des chaînes aléatoires longues, différentes en prod)
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Brevo (envoi des e-mails : codes d'activation et de réinitialisation)
# Clé API : Brevo > SMTP & API > Clés API
BREVO_API_KEY="[BREVO_API_KEY]"
# Doit correspondre à un expéditeur validé dans Brevo (domaine ou adresse vérifiée)
MAIL_FROM_EMAIL="no-reply@scoly.app"
MAIL_FROM_NOM="Scoly"

# Supabase Storage (logo, signature, cachet ; puis PDF des documents)
# Project Settings > API dans le dashboard Supabase.
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
# Clé "service_role" (jamais la clé "anon") : donne accès plein au bucket
# privé depuis le backend uniquement. Ne JAMAIS l'exposer au front.
SUPABASE_SERVICE_ROLE_KEY="[SUPABASE_SERVICE_ROLE_KEY]"
SUPABASE_STORAGE_BUCKET="scoly"

# Port d'écoute de l'API
PORT=3000

# Origine autorisée pour le CORS (URL du frontend)
CORS_ORIGIN="http://localhost:5173"
# Base des liens envoyés par e-mail (invitation d'équipe, etc.) — distincte
# de CORS_ORIGIN par intention, même si la valeur est identique en dev.
FRONT_URL="http://localhost:5173"

# URL de base du QR code des documents : <base>/<token>. Par défaut FRONT_URL + "/verifier".
# VERIFICATION_BASE_URL="https://scoly.app/verifier"

# --- Vérification publique des documents ---------------------------------
# Secret (16 caractères minimum, OBLIGATOIRE en production) servant à hacher les
# IP du journal des vérifications. Distinct des secrets JWT. Générer par ex. :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VERIFICATION_LOG_SECRET="change-me-verification-log"
# Origine(s) autorisée(s) à appeler POST /verification, séparées par des
# virgules. Par défaut : CORS_ORIGIN. Cette route n'accepte jamais de cookies.
# VERIFICATION_CORS_ORIGIN="http://localhost:5173"
# Nombre de proxys de confiance devant l'API (Render, Railway, Nginx… = 1).
# INDISPENSABLE en production : sans lui, tous les visiteurs partagent l'IP du
# proxy donc le même quota. Ne jamais mettre `true`. Vide/0 = aucun proxy (dev).
# TRUST_PROXY=1
